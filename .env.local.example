# ═══════════════════════════════════════════════════════════════════════════
# 🔐 ALWAFRA WEB3 - TEMPLATE CONFIGURATION D'ENVIRONNEMENT
# ═══════════════════════════════════════════════════════════════════════════
# ✅ INSTRUCTIONS : Copier ce fichier en .env.local et remplir les valeurs

# ───────────────────────────────────────────────────────────────────────────
# 1️⃣ IDENTIFICATION ALWAFRA
# ───────────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Alwafra Web3
VITE_APP_VERSION=1.0.0
VITE_FONDATEUR_ID=964/R/1970
VITE_FONDATEUR_NOM=MR MOHAMED MORCHID

# ───────────────────────────────────────────────────────────────────────────
# 2️⃣ WEB3 & WALLET CONNECT
# ───────────────────────────────────────────────────────────────────────────
# 🔴 REQUIS : Obtenir depuis https://cloud.walletconnect.com
VITE_WALLET_CONNECT_PROJECT_ID=votre_project_id_ici

# Réseau par défaut (mainnet, polygon, sepolia, mumbai)
VITE_DEFAULT_NETWORK=polygon

# Smart Contract Addresses (après déploiement)
VITE_ALWAFRA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ALWAFRA_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ALWAFRA_PRESALE_ADDRESS=0x0000000000000000000000000000000000000000

# Alchemy API (gratuit sur alchemy.com)
VITE_ALCHEMY_API_KEY=votre_alchemy_key_ici

# ───────────────────────────────────────────────────────────────────────────
# 3️⃣ CLÉS API EXTERNES
# ───────────────────────────────────────────────────────────────────────────
VITE_API_URL=https://api.alwafra.local
VITE_API_KEY=votre_clé_api
VITE_API_TIMEOUT_MS=5000

# Sentry (optionnel)
VITE_SENTRY_DSN=

# ───────────────────────────────────────────────────────────────────────────
# 4️⃣ SÉCURITÉ & CHIFFREMENT
# ───────────────────────────────────────────────────────────────────────────
# 🔴 CHANGER ABSOLUMENT EN PRODUCTION
VITE_ENCRYPTION_KEY=votre_clé_chiffrement_32_caractères_min
VITE_SECRET_TOKEN=votre_secret_token_32_caractères_min

# CORS
VITE_CORS_ORIGIN=http://localhost:3000

# ───────────────────────────────────────────────────────────────────────────
# 5️⃣ LIMITES FINANCIÈRES
# ───────────────────────────────────────────────────────────────────────────
# Plafond mensuel (MAD)
VITE_MAX_MONTHLY_REVENUE=50000

# Délai versement automatique (jours)
VITE_AUTO_PAYOUT_DAYS=90

# Adresse archivage Alwafra
VITE_ALWAFRA_WALLET_ADDRESS=0xAlwafraVaultAddress

# Banque par défaut
VITE_DEFAULT_BANK=CARTE_ALWAFRA

# ───────────────────────────────────────────────────────────────────────────
# 6️⃣ MODÈLE ÉCONOMIQUE (NE PAS MODIFIER)
# ───────────────────────────────────────────────────────────────────────────
VITE_VALEUR_BASE_MINUTE=7.00
VITE_VALEUR_CACHE_MINUTE=3.50
VITE_COUT_OUTIL_IA=2.00
VITE_TAUX_IMPOT_SOURCE=15
VITE_TAUX_COMMISSION=30

# ───────────────────────────────────────────────────────────────────────────
# 7️⃣ ENVIRONNEMENT
# ───────────────────────────────────────────────────────────────────────────
VITE_NODE_ENV=development
VITE_DEBUG_MODE=true
VITE_ADMIN_URL=http://localhost:5173/admin

# ───────────────────────────────────────────────────────────────────────────
# 8️⃣ MOBILE (EXPO)
# ───────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://api.alwafra.local
EXPO_PUBLIC_WALLET_CONNECT_ID=votre_project_id_ici

# ───────────────────────────────────────────────────────────────────────────
# 9️⃣ CONFORMITÉ
# ───────────────────────────────────────────────────────────────────────────
VITE_CERT_ISO27001=true
VITE_COMPLIANCE_RGPD=true
VITE_COMPLIANCE_UN_RIGHTS=true

# ═══════════════════════════════════════════════════════════════════════════
